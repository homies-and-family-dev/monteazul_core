// ============================================================
// MONTE AZUL SUITE — CORPORATE CORE
// Generic concepts only (no Marketing/Commercial/Administration-
// specific fields). See document point 51: "if a concept only
// exists because one area needs it, it must not become a Core
// concept."
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

// ------------------------------------------------------------
// AREAS
// ------------------------------------------------------------

model Area {
  id        String   @id @default(cuid())
  name      String   @unique   // "Marketing", "Commercial", "Administration"
  code      String   @unique   // "MKT", "COM", "ADM" — used to build ticket numbers
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  // Relations as origin/destination of a request
  requestsAsOrigin      Request[] @relation("RequestOriginArea")
  requestsAsDestination Request[] @relation("RequestDestinationArea")

  // Users with operational access to this area (document point 8)
  members   UserArea[]

  // Area-specific master values (points 24-25)
  masterValues MasterValue[]

  // Objetivos asociados al área (punto 29)
  goals        Goal[]
}

// ------------------------------------------------------------
// USERS, ROLES AND PERMISSIONS
// ------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?             // null if the user only logs in via Google
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  roles        UserRole[]
  areas        UserArea[]          // which areas this user has operational access to (can be none)

  requestsFiled Request[] @relation("UserFiler")
  assignments   Assignment[] @relation("UserAssignee")
  tasksAssigned Task[] @relation("TaskAssignee")
  comments      Comment[]
  statusHistory StatusHistory[] @relation("UserStatusAction")

  marketingContentsCreated  MarketingContent[] @relation("MarketingContentCreator")
  marketingContentsAssigned MarketingContent[] @relation("MarketingContentAssignee")

  campaignsCreated          MarketingCampaign[] @relation("CampaignCreator")
  campaignsAssigned         MarketingCampaign[] @relation("CampaignAssignee")

  equipmentLoansBorrower    EquipmentLoan[] @relation("EquipmentBorrower")
  equipmentLoansAuthorized  EquipmentLoan[] @relation("EquipmentLoanAuthorizer")

  loansDepartureDeliveredSigned EquipmentLoan[] @relation("LoanDepartureDeliveredSigner")
  loansDepartureReceivedSigned  EquipmentLoan[] @relation("LoanDepartureReceivedSigner")
  loansReturnDeliveredSigned    EquipmentLoan[] @relation("LoanReturnDeliveredSigner")
  loansReturnReceivedSigned     EquipmentLoan[] @relation("LoanReturnReceivedSigner")

  goalsResponsible          Goal[] @relation("GoalResponsible")
  goalsCreated              Goal[] @relation("GoalCreator")
  goalProgressUpdates       GoalProgressUpdate[]
  goalTasksAssigned         GoalTask[] @relation("GoalTaskAssignee")

  commercialBookingsAssigned CommercialBooking[] @relation("CommercialBookingAdvisor")
  commercialBookingsCreated  CommercialBooking[] @relation("CommercialBookingCreator")

  commercialQuotesCreated   CommercialQuote[]    @relation("CommercialQuoteCreator")
  commercialQuotesAssigned  CommercialQuote[]    @relation("CommercialQuoteAdvisor")
  commercialQuotesValidated CommercialQuote[]    @relation("CommercialQuoteValidator")
  commercialContractsCreated CommercialContract[] @relation("CommercialContractCreator")

  commercialClientsCreated  CommercialClient[]   @relation("CommercialClientCreator")
  commercialClientsAdvised  CommercialClient[]   @relation("CommercialClientAdvisor")
}

// A user's operational access to an area (independent from "can file requests")
model UserArea {
  id     String @id @default(cuid())
  userId String
  areaId String
  user   User   @relation(fields: [userId], references: [id])
  area   Area   @relation(fields: [areaId], references: [id])

  @@unique([userId, areaId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique   // "Operator", "Area Director", "General Administrator"...
  description String?
  users       UserRole[]
  permissions RolePermission[]
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String?
  description String?
  module      String?
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

// ------------------------------------------------------------
// REQUESTS (the core of the system — document points 7 and 57)
// ------------------------------------------------------------

enum RequestStatus {
  FILED
  ASSIGNED
  IN_PROGRESS
  IN_REVIEW
  RESUBMITTED
  DELIVERED
  RETURNED
  PENDING_CONFIRMATION
  CLOSED
}

model Request {
  id            String        @id @default(cuid())
  ticketNumber  String        @unique   // e.g. "MKT-000123", built from the destination area's code

  filedById     String
  filedBy       User          @relation("UserFiler", fields: [filedById], references: [id])

  originAreaId      String
  originArea        Area      @relation("RequestOriginArea", fields: [originAreaId], references: [id])

  destinationAreaId String
  destinationArea   Area      @relation("RequestDestinationArea", fields: [destinationAreaId], references: [id])

  type          String        // references a MasterValue (request type)
  priority      String?       // references a MasterValue
  title         String
  description   String

  status        RequestStatus @default(FILED)

  filedAt       DateTime      @default(now())
  dueDate       DateTime?

  assignments   Assignment[]
  statusHistory StatusHistory[]
  comments      Comment[]
  files         File[]
  tasks         Task[]
  marketingContents MarketingContent[]
  equipmentLoans    EquipmentLoan[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// Who ended up assigned to work the request (there can be more than one over time)
model Assignment {
  id           String   @id @default(cuid())
  requestId    String
  request      Request  @relation(fields: [requestId], references: [id])
  userId       String
  user         User     @relation("UserAssignee", fields: [userId], references: [id])
  assignedById String
  date         DateTime @default(now())
}

// Status transition log — this is what lets you measure time (points 17-19)
model StatusHistory {
  id             String         @id @default(cuid())
  requestId      String
  request        Request        @relation(fields: [requestId], references: [id])
  previousStatus RequestStatus?
  newStatus      RequestStatus
  userId         String
  user           User           @relation("UserStatusAction", fields: [userId], references: [id])
  date           DateTime       @default(now())
  note           String?        // e.g. reason for a return
}

// Work derived from a request (point 20).
model Task {
  id           String    @id @default(cuid())
  requestId    String
  request      Request   @relation(fields: [requestId], references: [id])
  title        String
  status       String    @default("pendiente") // "pendiente" | "en_proceso" | "completada"
  assignedToId String?
  assignedTo   User?     @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  durationMs   Int       @default(0)

  equipmentLoans EquipmentLoan[]
}

// ------------------------------------------------------------
// CONTEXTUAL COMMUNICATION (point 22)
// ------------------------------------------------------------

model Comment {
  id        String   @id @default(cuid())
  requestId String
  request   Request  @relation(fields: [requestId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  date      DateTime @default(now())

  files     File[]
}

// Either a direct attachment OR an external link (Drive) — point 22.6
model File {
  id        String   @id @default(cuid())
  requestId String?
  request   Request? @relation(fields: [requestId], references: [id])
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id])

  type      String   // "attachment" | "link"
  name      String
  url       String   // storage path or Drive URL
  createdAt DateTime @default(now())
}

// ------------------------------------------------------------
// MASTER DATA (points 24-25)
// ------------------------------------------------------------

model MasterType {
  id     String        @id @default(cuid())
  key    String        @unique  // "request_type", "priority", "content_type"...
  name   String
  values MasterValue[]
}

model MasterValue {
  id           String     @id @default(cuid())
  masterTypeId String
  masterType   MasterType @relation(fields: [masterTypeId], references: [id])
  areaId       String?    // null = corporate master value; set = area-specific
  area         Area?      @relation(fields: [areaId], references: [id])
  value        String
  active       Boolean    @default(true)

  @@unique([masterTypeId, areaId, value])
}

// ============================================================
// MARKETING FUNCTIONAL MODULE (points 32-36)
// Specific to the Marketing area without overloading the corporate core
// ============================================================

model MarketingContent {
  id           String    @id @default(cuid())
  brand        String    // Marca (ej: "Monte Azul", "Monte Azul Inmobiliaria")
  date         DateTime  // Fecha programada (año, mes, semana, día)
  title        String    // Tema del contenido
  format       String    // Formato: "Carrusel", "Reel / Video Corto", "Post Estático", "Historia", etc.
  objective    String    // Objetivo: "Alcance", "Engagement", "Conversión", "Branding"
  platforms    String    // Plataformas separadas por comas (ej: "Instagram, Facebook, TikTok")
  copy         String?   @db.Text // Copywriting / caption
  fileUrl      String?   // Enlace a archivos finales / Google Drive / OneDrive
  thumbnailUrl String?   // Enlace a miniatura o previsualización
  status       String    @default("Borrador") // "Borrador" | "En Producción" | "En Aprobación" | "Aprobado" | "Publicado" | "Cancelado"
  notes        String?   @db.Text // Notas internas de producción

  createdById  String
  createdBy    User      @relation("MarketingContentCreator", fields: [createdById], references: [id])

  assignedToId String?
  assignedTo   User?     @relation("MarketingContentAssignee", fields: [assignedToId], references: [id])

  requestId    String?   // Vinculación opcional con una solicitud del Core Corporativo
  request      Request?  @relation(fields: [requestId], references: [id])

  campaignId   String?   // Vinculación con Campaña de Marketing
  campaign     MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([date])
  @@index([status])
  @@index([brand])
  @@index([campaignId])
}

// ------------------------------------------------------------
// MARKETING CAMPAIGNS (Módulo Exclusivo de Campañas de Marketing)
// ------------------------------------------------------------

model MarketingCampaign {
  id              String            @id @default(cuid())
  code            String            @unique // ej: "CMP-2026-001"
  name            String            // Título o nombre de la campaña
  brand           String            // Marca: "Monte Azul", "Monte Azul Inmobiliaria", etc.
  projectName     String?           // Proyecto inmobiliario relacionado (ej. "Altos del Este")
  objective       String            // "Generación de Leads", "Branding y Reconocimiento", "Lanzamiento Inmobiliario", "Conversión y Ventas"
  startDate       DateTime          // Fecha de inicio
  endDate         DateTime?         // Fecha fin estimada
  status          String            @default("Planificación") // "Planificación" | "Activa" | "Pausada" | "Finalizada" | "Cancelada"
  budget          Float             @default(0) // Presupuesto asignado en COP
  spent           Float             @default(0) // Presupuesto ejecutado en COP
  targetAudience  String?           // Segmento / Público objetivo
  channels        String            // Canales: "Meta Ads, Google Ads, Vallas, Redes, Eventos"
  description     String?           @db.Text // Concepto creativo y descripción
  expectedKpis    String?           @db.Text // Indicadores y metas esperadas (leads, conversiones, etc.)

  createdById     String
  createdBy       User              @relation("CampaignCreator", fields: [createdById], references: [id])

  assignedToId    String?
  assignedTo      User?             @relation("CampaignAssignee", fields: [assignedToId], references: [id])

  contents        MarketingContent[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
  @@index([brand])
  @@index([startDate])
}

// ------------------------------------------------------------
// MARKETING EQUIPMENT & LOANS (point 35, F-MKT-01, F-MKT-02)
// ------------------------------------------------------------

model Equipment {
  id                String              @id @default(cuid())
  code              String              @unique // "EQ-MKT-001"
  name              String              // "Cámara Sony Alpha 7 IV"
  category          String              // "Cámaras", "Lentes / Óptica", "Iluminación", "Audio", "Drones", "Estabilizadores / Trípodes", "Accesorios"
  brand             String              // "Sony", "DJI", "Rode", "Godox"
  model             String?
  serialNumber      String?
  status            String              @default("Disponible") // "Disponible" | "Prestado" | "En Mantenimiento" | "Baja"
  physicalCondition String              @default("Excelente") // "Excelente" | "Bueno" | "Regular" | "Con detalles"
  location          String?             // "Armario Audiovisual Marketing - Estante 2"
  accessories       String?             // "2 baterías, cargador, estuche rígido, tarjeta SD 128GB"
  photoUrl          String?
  notes             String?

  loanItems         EquipmentLoanItem[]

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status])
  @@index([category])
}

model EquipmentLoan {
  id                 String              @id @default(cuid())
  folio              String              @unique // "PREST-MKT-000001"
  purpose            String              // Motivo / Salida a campo / Proyecto
  startDate          DateTime            // Fecha y hora de salida / entrega
  expectedReturnDate DateTime            // Fecha y hora comprometida de devolución
  actualReturnDate   DateTime?           // Fecha y hora real de devolución
  status             String              @default("Solicitado") // "Solicitado" | "Aprobado" | "Entregado" | "Devuelto" | "Devuelto con Novedad" | "Rechazado"

  borrowerId         String
  borrower           User                @relation("EquipmentBorrower", fields: [borrowerId], references: [id])

  authorizedById     String?
  authorizedBy       User?               @relation("EquipmentLoanAuthorizer", fields: [authorizedById], references: [id])

  taskId             String?
  task               Task?               @relation(fields: [taskId], references: [id])

  requestId          String?
  request            Request?            @relation(fields: [requestId], references: [id])

  departureNotes     String?             // Observaciones en la entrega inicial
  departurePhotoUrl  String?             // Fotos antes de la entrega (F-MKT-01)
  returnNotes        String?             // Observaciones en la recepción/devolución
  returnPhotoUrl     String?             // Fotos al devolver (F-MKT-02)

  // Firmas Digitales F-MKT-01 (Acta de Entrega de Equipos)
  departureDeliveredSignedAt     DateTime?
  departureDeliveredSignedById   String?
  departureDeliveredSignedBy     User?               @relation("LoanDepartureDeliveredSigner", fields: [departureDeliveredSignedById], references: [id])
  departureDeliveredSignature    String?             @db.Text // Firma trazada / Base64 o sello institucional
  departureReceivedSignedAt      DateTime?
  departureReceivedSignedById    String?
  departureReceivedSignedBy      User?               @relation("LoanDepartureReceivedSigner", fields: [departureReceivedSignedById], references: [id])
  departureReceivedSignature     String?             @db.Text // Firma trazada / Base64
  departureSignatureHash         String?             // Hash criptográfico de verificación SHA-256

  // Firmas Digitales F-MKT-02 (Acta de Devolución e Inspección de Equipos)
  returnDeliveredSignedAt        DateTime?
  returnDeliveredSignedById      String?
  returnDeliveredSignedBy        User?               @relation("LoanReturnDeliveredSigner", fields: [returnDeliveredSignedById], references: [id])
  returnDeliveredSignature       String?             @db.Text // Firma trazada / Base64
  returnReceivedSignedAt         DateTime?
  returnReceivedSignedById       String?
  returnReceivedSignedBy         User?               @relation("LoanReturnReceivedSigner", fields: [returnReceivedSignedById], references: [id])
  returnReceivedSignature        String?             @db.Text // Firma trazada / Base64 o sello institucional
  returnSignatureHash            String?             // Hash criptográfico de verificación SHA-256

  items              EquipmentLoanItem[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status])
  @@index([borrowerId])
}

model EquipmentLoanItem {
  id                   String        @id @default(cuid())
  loanId               String
  loan                 EquipmentLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  equipmentId          String
  equipment            Equipment     @relation(fields: [equipmentId], references: [id])

  conditionAtDeparture String?       // Condición física al entregar
  conditionAtReturn    String?       // Condición física al recibir
  notes                String?

  @@unique([loanId, equipmentId])
}

// ============================================================
// CORPORATE AND AREA GOALS & OBJECTIVES (point 29)
// ============================================================

model Goal {
  id           String    @id @default(cuid())
  title        String    // Título del objetivo
  description  String?   // Descripción detallada / Justificación
  scope        String    // "Gerencial" | "Área"
  horizon      String    // "Corto Plazo" | "Mediano Plazo" | "Largo Plazo"
  period       String    // Período de evaluación (ej: "Q1 2026", "Año 2026")
  startDate    DateTime  // Inicio de medición
  endDate      DateTime  // Fecha límite de cumplimiento

  indicator    String    // Indicador o métrica asociada
  targetValue  Float     // Meta cuantitativa (ej: 95, 24, 30)
  currentValue Float     @default(0) // Valor actual alcanzado
  unit         String    // Unidad de medida (ej: "%", "horas", "solicitudes", "publicaciones")
  status       String    @default("En Curso") // "En Curso" | "Cumplido" | "En Riesgo" | "No Cumplido" | "Pausado"

  areaId       String?   // null = Corporativo / Gerencial; set = Específico de un Área
  area         Area?     @relation(fields: [areaId], references: [id])

  responsibleId String   // Director o Gerente responsable del cumplimiento
  responsible   User     @relation("GoalResponsible", fields: [responsibleId], references: [id])

  createdById   String
  createdBy     User     @relation("GoalCreator", fields: [createdById], references: [id])

  progressUpdates GoalProgressUpdate[]
  tasks           GoalTask[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([scope])
  @@index([status])
  @@index([areaId])
}

model GoalProgressUpdate {
  id            String   @id @default(cuid())
  goalId        String
  goal          Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  userId        String
  user          User     @relation(fields: [userId], references: [id])

  previousValue Float
  newValue      Float
  note          String   // Justificación o resumen del avance registrado

  createdAt     DateTime @default(now())
}

model GoalTask {
  id           String    @id @default(cuid())
  goalId       String
  goal         Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title        String
  status       String    @default("pendiente") // "pendiente" | "en_proceso" | "completada"
  assignedToId String?
  assignedTo   User?     @relation("GoalTaskAssignee", fields: [assignedToId], references: [id])
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  @@index([goalId])
  @@index([status])
}

// ------------------------------------------------------------
// COMMERCIAL CLIENTS / DIRECTORIO UNIFICADO DE CLIENTES
// ------------------------------------------------------------

model CommercialClient {
  id                 String              @id @default(cuid())
  name               String              // Nombre completo o razón social
  docType            String              @default("CC") // CC, CE, NIT, Pasaporte
  docNumber          String?             @unique // Identificación única (opcional al inicio)
  phone              String              // Teléfono / WhatsApp
  email              String?             // Correo electrónico
  address            String?             // Dirección
  city               String?             @default("Colombia")
  civilStatus        String?             // Soltero(a), Casado(a), etc.
  bank               String?             // Entidad / Cuenta bancaria
  occupation         String?             // Ocupación o profesión
  notes              String?             // Perfil comercial y notas

  // Relaciones para trazabilidad 360°
  bookings           CommercialBooking[]
  quotes             CommercialQuote[]
  contracts          CommercialContract[]

  assignedAdvisorId  String?
  assignedAdvisor    User?               @relation("CommercialClientAdvisor", fields: [assignedAdvisorId], references: [id])
  createdById        String?
  createdBy          User?               @relation("CommercialClientCreator", fields: [createdById], references: [id])

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([name])
  @@index([phone])
  @@index([email])
}

// ------------------------------------------------------------
// COMMERCIAL BOOKINGS / AGENDAMIENTO DE VISITAS A TERRENO
// ------------------------------------------------------------

model CommercialBooking {
  id                String            @id @default(cuid())
  project           String            // "Monteazul Club Náutico", "Golf Club", "Reservas de Prado", "Pirate Paradise", "Las Victorias", etc.
  clientName        String
  clientEmail       String
  clientPhone       String            // Teléfono / WhatsApp
  numAttendees      Int               @default(1)
  date              DateTime          // Fecha y hora de inicio de la visita
  durationMinutes   Int               @default(90) // Duración estándar de 90 min (como zcal)
  status            String            @default("AGENDADA") // "AGENDADA" | "CONFIRMADA" | "REALIZADA" | "CANCELADA" | "REPROGRAMADA" | "NO_ASISTIO"
  notes             String?           // Notas de visita / Encuesta previa
  transportNeed     Boolean           @default(false) // Si requiere transporte proporcionado por Monteazul
  feedbackNotes     String?           // Notas de seguimiento comercial posteriores a la visita

  // Vinculación al cliente unificado
  clientId          String?
  client            CommercialClient? @relation(fields: [clientId], references: [id])

  quotes            CommercialQuote[]

  assignedAdvisorId String?
  assignedAdvisor   User?             @relation("CommercialBookingAdvisor", fields: [assignedAdvisorId], references: [id])

  createdById       String?
  createdBy         User?             @relation("CommercialBookingCreator", fields: [createdById], references: [id])

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([date])
  @@index([status])
  @@index([project])
  @@index([assignedAdvisorId])
  @@index([clientId])
}

// ------------------------------------------------------------
// COMMERCIAL MODULE: COTIZACIONES Y CONTRATOS DE SEPARACIÓN
// ------------------------------------------------------------

enum CommercialQuoteStatus {
  BORRADOR
  EMITIDA
  EN_VALIDACION
  CONTRATADA
  CANCELADA
}

enum CommercialContractStatus {
  VIGENTE
  FIRMADO
  LEGALIZADO
  DESISTIDO
  ANULADO
}

model CommercialQuote {
  id                  String                @id @default(cuid())
  consecutive         String                @unique // ej. "COT-2026-0001"
  status              CommercialQuoteStatus @default(EMITIDA)
  date                DateTime              @default(now())
  validityDays        Int                   @default(3) // 3 días según nota legal del PDF

  // Datos del Proyecto y Lote
  projectName         String                // Nombre del proyecto comercial
  stage               String?               // Etapa (ej: "1")
  block               String?               // Manzana (ej: "A")
  lotNumber           String                // Lote (ej: "Lote 14")
  totalArea           Float                 // Área total en m²
  pricePerSquareMeter Float                 // Valor por m²
  totalPrice          Float                 // Valor del Inmueble (totalArea * pricePerSquareMeter)

  // Cliente / Titular Principal (Optante 1)
  clientName          String
  clientDocType       String                @default("CC") // CC, CE, NIT, Pasaporte
  clientDocNumber     String
  clientPhone         String
  clientEmail         String
  clientAddress       String
  clientCity          String                @default("Colombia")
  clientCivilStatus   String?               // Soltero(a), Casado(a), Unión Libre, Divorciado(a), Viudo(a)
  clientBank          String?               // Banco o entidad financiera
  clientParticipation Float                 @default(100) // % de participación (ej. 100% o 50%)

  // Segundo Comprador (Optante 2 - Opcional)
  hasSecondOptant           Boolean         @default(false)
  secondOptantName          String?
  secondOptantDocType       String?         @default("CC")
  secondOptantDocNumber     String?
  secondOptantPhone         String?
  secondOptantEmail         String?
  secondOptantAddress       String?
  secondOptantCity          String?
  secondOptantCivilStatus   String?
  secondOptantBank          String?
  secondOptantParticipation Float?

  // Plan Financiero y Descuentos
  hasDiscount         Boolean               @default(false)
  discountAmount      Float                 @default(0)
  discountDescription String?               // Motivo o bono de descuento
  finalPrice          Float                 // Valor final Lote (totalPrice - discountAmount)
  reservationAmount   Float                 @default(0) // Valor de separación pactado
  reservationDate     DateTime?             // Fecha de pago de separación
  initialQuotaPercent Float                 @default(10) // % cuota inicial (10% según contrato)
  initialQuotaAmount  Float                 @default(0) // Valor cuota inicial
  financedBalance     Float                 // Saldo valor lote a financiar
  installmentsCount   Int                   @default(12) // Número de cuotas pactadas
  installmentAmount   Float                 // Valor de la cuota mensual aproximada
  observations        String?               // Observaciones

  // Validación de Datos para pase a Contrato
  dataValidated       Boolean               @default(false)
  validatedAt         DateTime?
  validatedById       String?
  validatedBy         User?                 @relation("CommercialQuoteValidator", fields: [validatedById], references: [id])
  validationNotes     String?

  // Asignación Comercial y Auditoría
  advisorId           String?
  advisor             User?                 @relation("CommercialQuoteAdvisor", fields: [advisorId], references: [id])
  createdById         String?
  createdBy           User?                 @relation("CommercialQuoteCreator", fields: [createdById], references: [id])

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  // Contrato de separación generado a partir de esta cotización
  contract            CommercialContract?

  // Vinculación opcional con agendamiento previo (trazabilidad de origen de la cita)
  bookingId           String?
  booking             CommercialBooking?    @relation(fields: [bookingId], references: [id])

  // Vinculación al cliente unificado
  clientId            String?
  client              CommercialClient?     @relation(fields: [clientId], references: [id])

  @@index([status])
  @@index([projectName])
  @@index([clientDocNumber])
  @@index([advisorId])
  @@index([clientId])
  @@index([bookingId])
}

model CommercialContract {
  id                      String                   @id @default(cuid())
  contractNumber          String                   @unique // ej. "CS-2026-0001"
  status                  CommercialContractStatus @default(VIGENTE)
  date                    DateTime                 @default(now())

  // Vinculación estricta con la cotización
  quoteId                 String                   @unique
  quote                   CommercialQuote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  // Promotor (Snapshot institucional Monteazul Group S.A.S)
  promoterName            String                   @default("MONTEAZUL GROUP S.A.S")
  promoterNit             String                   @default("901.662.298-6")
  promoterRegistration    String                   @default("352661 de la Cámara de Comercio de Ibagué")
  promoterLegalRep        String                   @default("ANDRES FELIPE ALVAREZ GRANADOS")
  promoterRepDoc          String                   @default("1.110.540.527")
  promoterAddress         String                   @default("Cra 5ta Sur No. 83-40 Mall Comercial La Florida 3 local 8, Ibagué / Bogotá: Edificio Business 93 Of 406")
  promoterPhone           String                   @default("+573124233810")
  promoterEmail           String                   @default("gerencia.comercial@monteazulgroup.com")

  // Objeto y Datos del Inmueble
  projectName             String
  projectLocation         String                   // Ubicación legal del predio/conjunto
  stage                   String                   @default("1")
  block                   String                   @default("A")
  lotNumber               String
  totalArea               Float

  // Optante 1 (Titular)
  optant1Name             String
  optant1DocType          String                   @default("CC")
  optant1Doc              String
  optant1Participation    Float                    @default(100)
  optant1Address          String
  optant1City             String
  optant1Phone            String
  optant1Email            String
  optant1CivilStatus      String
  optant1Bank             String

  // Optante 2 (si aplica)
  hasOptant2              Boolean                  @default(false)
  optant2Name             String?
  optant2DocType          String?
  optant2Doc              String?
  optant2Participation    Float?
  optant2Address          String?
  optant2City             String?
  optant2Phone            String?
  optant2Email            String?
  optant2CivilStatus      String?
  optant2Bank             String?

  // Cláusulas Económicas y Financieras
  totalPrice              Float
  totalPriceWords         String?                  // Texto en letras (ej: "CIEN PESOS M/CTE")
  reservationAmount       Float
  reservationAmountWords  String?
  reservationPaymentDate  DateTime?
  hasDiscount             Boolean                  @default(false)
  discountAmount          Float                    @default(0)
  initialQuotaPercent     Float                    @default(10)
  initialQuotaAmount      Float
  balanceAmount           Float
  balanceAmountWords      String?
  installmentsCount       Int                      @default(12)
  authorizedBankAccounts  String                   // Cuentas autorizadas del proyecto para pagos

  // Control de firmas y notas
  isSigned                Boolean                  @default(false)
  signedAt                DateTime?
  notes                   String?

  // Auditoría
  createdById             String?
  createdBy               User?                    @relation("CommercialContractCreator", fields: [createdById], references: [id])
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  // Vinculación al cliente unificado
  clientId                String?
  client                  CommercialClient?        @relation(fields: [clientId], references: [id])

  @@index([contractNumber])
  @@index([status])
  @@index([projectName])
  @@index([clientId])
}

// ------------------------------------------------------------
// PROYECTOS INMOBILIARIOS / COMERCIALES
// ------------------------------------------------------------

model CommercialProject {
  id                     String   @id @default(cuid())
  slug                   String   @unique
  name                   String   // Nombre comercial visible (ej. "Club Náutico Monteazul")
  legalName              String   // Denominación legal para minutas y contratos (ej. "CLUB NÁUTICO MONTEAZUL")
  location               String   // Ubicación legal (ej. "Vereda Tomogó zona del municipio de Prado – Tolima")
  cityDepartment         String   // Ciudad / Departamento (ej. "Prado, Tolima")
  authorizedBankAccounts String   // Cuentas bancarias autorizadas para pagos y separaciones
  defaultPricePerM2      Float    @default(150000) // Precio base por m² por defecto
  stages                 String[] @default(["Etapa 1"]) // Etapas disponibles
  blocks                 String[] @default(["Manzana A"]) // Manzanas disponibles
  description            String?  // Descripción / características comerciales
  logoUrl                String?  // Ruta o URL de la imagen del logotipo del proyecto
  active                 Boolean  @default(true) // Habilitado / Deshabilitado
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([active])
  @@index([name])
}
